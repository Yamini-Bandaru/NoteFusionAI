# ==============================================================================
# NoteFusionAI Environment Variables Configuration
# ==============================================================================

# 1. GEMINI_API_KEY: Required for Gemini AI multimodal audio, video & notes processing.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. APP_URL: The URL where this applet is hosted (used for verification links).
APP_URL="http://localhost:3000"

# 3. JWT_SECRET: Secret key used to sign and verify user authentication tokens.
JWT_SECRET="notefusion-secure-jwt-academic-secret-key-2026"

# ==============================================================================
# REAL EMAIL VERIFICATION & DELIVERY CONFIGURATION
# Configure either Option A (SMTP) or Option B (Resend API) for live inbox emails:
# ==============================================================================

# OPTION A: Standard SMTP (SendGrid, Brevo, AWS SES, Mailgun, Postmark, or Gmail)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey_or_username"
SMTP_PASS="your_smtp_password_or_token"
SMTP_SECURE="false"

# OPTION B: Resend API (Alternative to SMTP)
# RESEND_API_KEY="re_123456789abcdef"

# SENDER IDENTITY:
EMAIL_FROM="NoteFusionAI <noreply@notefusion.ai>"
